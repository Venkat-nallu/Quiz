<html>

<head>

    <title>
        <%= title %>
    </title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel = "stylesheet" href = "https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <link rel = "stylesheet" href = "../assets/css/quiz-style.css">

    
</head>

<body>
    <%- include('../assets/js/quiz-question'); %>
    <%- include('../assets/js/quiz-site'); %>

    <div id="review-container" class="container-sm">

        let c = 0;
        <ul class="list-group">

            <% for(let i of quiz){ %>

                <li class="list-group-item">
                    <span class="badge badge-primary badge-pill">Question - <%= c+1 %> </span>
                    <span><%= i.q %></i.q></span>
                </li>

                <li class="list-group-item">

                    <span class="badge badge-primary badge-pill">Your answer</span>

                    <span>

                        <% if(optionsEnteredByUser[c] == undefined){ %>
                            <span class="badge badge-primary badge-pill">Not answered</span>
                        
                        
                        <%} else { %>

                            <span><%= i[options][ optionsEnteredByUser[c] ] %></span>

                            <% if( optionsEnteredByUser[c] == i.q.answer ) %>
                                <span class="badge badge-primary badge-success">Correct</span>
                          
                                <span class="badge badge-primary badge-danger">Wrong</span>

                        <% } %>   

                    </span>

                </li>

                <li class="list-group-item">
                    <span class="badge badge-primary badge-pill">Correct answer</span>
                    <span><%= i[options][answer] %></span>
                </li>

                <br>
                ++c;

            <% } %>

        </ul>

    </div>

</body>

    <script type="text/javascript" src="../assets/js/quiz-question.js"> </script>
    <script type="text/javascript" src="../assets/js/quiz-site.js"> </script>

</html>